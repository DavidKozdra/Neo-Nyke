#!/bin/sh

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: Node.js is not available in Git's PATH." >&2
  exit 1
fi

npm run precache || exit $?
git add -- Koz_Engine_Lib/Core/koz-engine.browser-bundle.js sw.js || exit $?
npm run precache:check || exit $?
node scripts/check-i18n.js --strict || exit $?
exec node scripts/run-tests.js
