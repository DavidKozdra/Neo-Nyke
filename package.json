{
  "name": "neonyke",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/install-git-hooks.js",
    "icons": "node generate-icons.js",
    "test": "npm run precache:check && node scripts/run-tests.js",
    "i18n:check": "node scripts/check-i18n.js --strict",
    "i18n:check:structure": "node scripts/check-i18n.js",
    "i18n:check:strict": "node scripts/check-i18n.js --strict",
    "i18n:fill": "node scripts/fill-i18n-translations.js",
    "i18n:sync": "node scripts/sync-i18n-content.js",
    "start": "npm run precache && python3 -m http.server 5173",
    "start:py": "npm run precache && python -m http.server 5173",
    "editor": "node server/editor-server.js",
    "multiplayer:local": "node scripts/run-local-multiplayer-harness.js",
    "multiplayer:load": "node scripts/load-multiplayer-slo.js",
    "multiplayer:profile": "node scripts/profile-multiplayer-bottlenecks.js --enforce",
    "multiplayer:latency": "node scripts/benchmark-multiplayer-latency.js --enforce",
    "multiplayer:action": "node scripts/benchmark-multiplayer-action-latency.js --enforce",
    "multiplayer:wire": "node scripts/benchmark-multiplayer-wire.js --enforce",
    "multiplayer:verify": "npm run multiplayer:wire && npm run multiplayer:latency && npm run multiplayer:action && npm run multiplayer:profile",
    "multiplayer:playwright:40": "NEONYKE_PLAYWRIGHT_PLAYERS=40 node scripts/load-browser-multiplayer.js",
    "multiplayer:playwright:100": "node scripts/load-browser-multiplayer.js",
    "multiplayer:dev": "npm run build && server/node_modules/.bin/wrangler dev --config wrangler.toml",
    "multiplayer:dev:load": "npm run build && server/node_modules/.bin/wrangler dev --config wrangler.toml --var MULTIPLAYER_LOAD_TEST_TOKEN:playwright-local-100",
    "multiplayer:smoke": "node scripts/smoke-cloudflare-multiplayer.js",
    "koz-bundle": "node scripts/generate-koz-browser-bundle.js",
    "koz-bundle:check": "node scripts/generate-koz-browser-bundle.js --check",
    "precache": "npm run koz-bundle && node scripts/generate-precache.js",
    "precache:check": "npm run koz-bundle:check && node scripts/generate-precache.js --check",
    "build": "npm run precache && rm -rf dist && mkdir -p dist && cp -r index.html game.html sw.js manifest.json css js assets dist/ && node scripts/verify-precache-build.js dist"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "jest": "^30.4.2",
    "playwright": "^1.61.0",
    "terser": "^5.0.0"
  },
  "dependencies": {
    "koz-engine-lib": "0.1.0",
    "three": "^0.185.1"
  }
}
